{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "generated": ["./generated/src/index.ts", "./generated/index.ts"],
      "generated/*": ["./generated/src/*", "./generated/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "envio-env.d.ts", ".envio/types.d.ts"]
}
