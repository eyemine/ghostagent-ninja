# GhostAgent.ninja Environment Variables
# Copy to .env.local and fill in real values
# Never commit .env files to git

# === App Configuration ===
NEXT_PUBLIC_APP_URL=https://ghostagent.ninja
NEXT_PUBLIC_NETWORK=gnosis

# === Privy Auth ===
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret

# === Cloudflare Worker ===
# Use secret worker URL instead of public default
NFTMAIL_WORKER_URL=https://your-worker.your-subdomain.workers.dev
WEBHOOK_SECRET=your-webhook-secret-for-kv-mutations

# === Email Provider (Mailgun Foundation) ===
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.ghostmail.box
MAILGUN_WEBHOOK_SIGNING_KEY=your-webhook-signing-key

# === IPFS (Lighthouse) ===
LIGHTHOUSE_API_KEY=your-lighthouse-api-key
LIGHTHOUSE_API_URL=https://api.lighthouse.storage

# === Blockchain (Gnosis) ===
GNOSIS_RPC_URL=https://rpc.gnosischain.com
ETH_RPC_URL=https://mainnet.infura.io/v3/your-key
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# === Smart Contract Addresses ===
# These are public but useful to have as env vars
NEXT_PUBLIC_GHOST_REGISTRY=0x73f2f2ef73dc512cac0f5b0372f1d58a84ed13e6
NEXT_PUBLIC_MOLT_REGISTRAR=0x4b54213c1e5826497ff39ba8c87a7b75d2bc3c50
NEXT_PUBLIC_HITL_FACTORY_ADDRESS=0xB2Ad4C8368c8C02976124a5f75F951Fd24C5631D

# === Story Protocol (for IP registration) ===
STORY_API_KEY=your-story-api-key
STORY_RPC_URL=https://story-aeneid-rpc.example.com

# === Deployment ===
# For Foundry scripts
PLATFORM_SAFE=0xb7e493e3d226f8fE722CC9916fF164B793af13F4
ARBITRATOR_ADDRESS=0x...your-arbitrator...
PRIVATE_KEY=your-deployer-private-key-without-0x-prefix

# === Monitoring ===
SENTRY_DSN=your-sentry-dsn
LOG_LEVEL=info
